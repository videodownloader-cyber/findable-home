---
interface Props {
    images: string[];
}

const { images } = Astro.props;
const mainImage =
    images[0] ||
    "/images/products/product-gallery-fallback.webp";
---

<div class="product-gallery space-y-6">
    <!-- Main Image -->
    <div
        class="aspect-4/5 md:aspect-square bg-slate-100 rounded-3xl overflow-hidden relative group border border-slate-200 shadow-inner"
    >
        <img
            id="main-product-image"
            src={mainImage}
            alt="Product View"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
        />
    </div>

    <!-- Thumbnails -->
    <div class="grid grid-cols-4 gap-4">
        {
            images.map((img, index) => (
                <button
                    type="button"
                    class="cursor-pointer thumbnail-btn aspect-square rounded-2xl overflow-hidden border-2 transition-all p-1 bg-slate-50 border-slate-100"
                    data-image={img}
                    aria-label={`View product image ${index + 1}`}
                    aria-pressed={index === 0 ? "true" : "false"}
                >
                    <img
                        src={img}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover rounded-xl"
                    />
                </button>
            ))
        }
    </div>
</div>

<script>
    function setupGallery() {
        const mainImage = document.getElementById(
            "main-product-image",
        ) as HTMLImageElement;
        const thumbnailBtns = document.querySelectorAll<HTMLButtonElement>(
            ".thumbnail-btn",
        );

        if (!mainImage) return;

        thumbnailBtns.forEach((btn) => {
            if (btn.dataset.galleryInitialized === "true") return;
            btn.dataset.galleryInitialized = "true";

            btn.addEventListener("click", () => {
                const newSrc = btn.getAttribute("data-image");
                if (newSrc) {
                    mainImage.src = newSrc;

                    thumbnailBtns.forEach((b) => {
                        b.classList.remove(
                            "border-primary",
                            "bg-white",
                            "ring-4",
                            "ring-primary/10",
                        );
                        b.classList.add("border-slate-100", "bg-slate-50");
                        b.setAttribute("aria-pressed", "false");
                    });

                    btn.classList.add(
                        "border-primary",
                        "bg-white",
                        "ring-4",
                        "ring-primary/10",
                    );
                    btn.classList.remove("border-slate-100", "bg-slate-50");
                    btn.setAttribute("aria-pressed", "true");
                }
            });
        });

        if (thumbnailBtns[0]) {
            thumbnailBtns[0].classList.add(
                "border-primary",
                "bg-white",
                "ring-4",
                "ring-primary/10",
            );
            thumbnailBtns[0].classList.remove(
                "border-slate-100",
                "bg-slate-50",
            );
            thumbnailBtns[0].setAttribute("aria-pressed", "true");
        }
    }

    setupGallery();
    document.addEventListener("astro:page-load", setupGallery);
</script>
