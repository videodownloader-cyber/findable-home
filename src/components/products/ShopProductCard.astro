---
import { Icon } from "astro-icon/components";

interface Props {
    id: string;
    title: string;
    category: string;
    image: string | null;
    description?: string;
    benableUrl: string;
}

const {
    id,
    title,
    category,
    image,
    description,
    benableUrl,
} = Astro.props;
---

<article
    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-base-200 bg-base-100 transition-shadow duration-300 hover:shadow-lg"
    data-product-id={id}
    data-product-category={category}
>
    <a
        href={benableUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="block overflow-hidden bg-base-200"
        data-product-click
        data-destination-type="benable"
        aria-label={`View ${title} on Benable`}
    >
        <div class="product-image-frame relative aspect-square w-full overflow-hidden bg-base-200">
            {image ? (
                <>
                    <img
                        src={image}
                        alt={title}
                        loading="lazy"
                        decoding="async"
                        class="product-image h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />

                    <div
                        class="product-image-fallback absolute inset-0 hidden flex-col items-center justify-center gap-3 px-4 text-center text-base-content/50"
                        aria-label="Product image unavailable"
                    >
                        <Icon name="lucide:image" class="h-10 w-10" />
                        <span class="text-sm">Image temporarily unavailable</span>
                    </div>
                </>
            ) : (
                <div class="flex h-full w-full flex-col items-center justify-center gap-3 px-4 text-center text-base-content/50">
                    <Icon name="lucide:image" class="h-10 w-10" />
                    <span class="text-sm">Image coming soon</span>
                </div>
            )}
        </div>
    </a>

    <div class="flex flex-1 flex-col p-5">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">
            {category.replaceAll("-", " ")}
        </p>

        <h2 class="mb-3 text-lg font-bold leading-snug text-base-content">
            {title}
        </h2>

        {description && (
            <p class="mb-4 text-sm leading-relaxed text-base-content/70">
                {description}
            </p>
        )}

        <div class="mt-auto pt-3">
            <a
                href={benableUrl}
                target="_blank"
                rel="sponsored nofollow noopener noreferrer"
                data-product-click
                data-destination-type="benable"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-content transition-opacity hover:opacity-85"
            >
                View Product
                <Icon name="lucide:external-link" class="h-4 w-4" />
            </a>
        </div>
    </div>
</article>

<script>
    function setupProductImageFallbacks() {
        document.querySelectorAll<HTMLImageElement>(
            ".product-image-frame .product-image",
        ).forEach((image) => {
            if (image.dataset.fallbackReady === "true") return;

            image.dataset.fallbackReady = "true";

            const showFallback = () => {
                image.classList.add("hidden");

                const fallback = image.parentElement?.querySelector(
                    ".product-image-fallback",
                );

                fallback?.classList.remove("hidden");
                fallback?.classList.add("flex");
            };

            image.addEventListener("error", showFallback, { once: true });

            if (image.complete && image.naturalWidth === 0) {
                showFallback();
            }
        });
    }

    function setupShopProductTracking() {
        document.querySelectorAll<HTMLElement>(
           "#shop-product-grid [data-product-id]",
        ).forEach((card) => {
            if (card.dataset.trackingReady === "true") return;

            card.dataset.trackingReady = "true";

            card.querySelectorAll<HTMLAnchorElement>(
                "a[data-product-click]",
            ).forEach((link) => {
                link.addEventListener("click", () => {
                    const dataLayer = (
                        window as Window & {
                            dataLayer?: Record<string, unknown>[];
                        }
                    ).dataLayer;

                    if (!dataLayer) return;

                    dataLayer.push({
                        event: "affiliate_click",
                        item_id: card.dataset.productId ?? "",
                        item_name:
                            card.querySelector("h2")?.textContent?.trim() ?? "",
                        item_category: card.dataset.productCategory ?? "",
                        placement: "shop_grid",
                        destination_type:
                            link.dataset.destinationType ?? "unknown",
                        link_url: link.href,
                    });
                });
            });
        });
    }

    function setupShopProductComponents() {
        setupProductImageFallbacks();
        setupShopProductTracking();
    }

    setupShopProductComponents();

    document.addEventListener(
        "astro:page-load",
        setupShopProductComponents,
    );
</script>
