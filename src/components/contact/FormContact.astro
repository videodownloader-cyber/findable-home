
---

---

<form class="w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col">
            <label for="first-name" class="font-semibold text-[#0B2545] mb-2">
                First Name
            </label>
            <input
                type="text"
                id="first-name"
                name="firstName"
                autocomplete="given-name"
                placeholder="Your first name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>

        <div class="flex flex-col">
            <label for="last-name" class="font-semibold text-[#0B2545] mb-2">
                Last Name
            </label>
            <input
                type="text"
                id="last-name"
                name="lastName"
                autocomplete="family-name"
                placeholder="Your last name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>

        <div class="flex flex-col md:col-span-2">
            <label for="contact-email" class="font-semibold text-[#0B2545] mb-2">
                Email
            </label>
            <input
                type="email"
                id="contact-email"
                name="email"
                autocomplete="email"
                placeholder="Your email address"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>
    </div>

    <div class="flex flex-col mt-6">
        <label for="contact-message" class="font-semibold text-[#0B2545] mb-2">
            Message
        </label>
        <textarea
            id="contact-message"
            name="message"
            rows="5"
            placeholder="How can we help?"
            class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#F9C74F] resize-none"
            required
        ></textarea>
    </div>

    <div class="text-center md:text-right mt-8">
        <button
            type="submit"
            class="bg-primary text-primary-content hover:bg-primary/90 font-bold px-12 py-4 rounded-full cursor-pointer transition text-lg shadow-lg hover:shadow-xl hover:scale-105 transform duration-200"
        >
            Send Message
        </button>
    </div>
</form>

