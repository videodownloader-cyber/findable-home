
---
---

<form
    id="contact-form"
    class="w-full"
    action="https://api.web3forms.com/submit"
    method="POST"
>
    <input
        type="hidden"
        name="access_key"
        value="306de766-bdc9-4545-b45b-f2bdf2598ade"
    />
    <input
        type="hidden"
        name="subject"
        value="New Findable Home Contact Form Submission"
    />
    <input type="hidden" name="from_name" value="Findable Home Website" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col">
            <label for="first-name" class="font-semibold text-[#0B2545] mb-2">
                First Name
            </label>
            <input
                type="text"
                id="first-name"
                name="firstName"
                autocomplete="given-name"
                placeholder="Your first name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>

        <div class="flex flex-col">
            <label for="last-name" class="font-semibold text-[#0B2545] mb-2">
                Last Name
            </label>
            <input
                type="text"
                id="last-name"
                name="lastName"
                autocomplete="family-name"
                placeholder="Your last name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>

        <div class="flex flex-col md:col-span-2">
            <label for="contact-email" class="font-semibold text-[#0B2545] mb-2">
                Email
            </label>
            <input
                type="email"
                id="contact-email"
                name="email"
                autocomplete="email"
                placeholder="Your email address"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#F9C74F]"
                required
            />
        </div>
    </div>

    <div class="flex flex-col mt-6">
        <label for="contact-message" class="font-semibold text-[#0B2545] mb-2">
            Message
        </label>
        <textarea
            id="contact-message"
            name="message"
            rows="5"
            placeholder="How can we help?"
            class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#F9C74F] resize-none"
            required
        ></textarea>
    </div>

    <div
        id="form-status"
        class="mt-4"
        role="status"
        aria-live="polite"
        hidden
    ></div>

    <div class="text-center md:text-right mt-8">
        <button
            id="contact-submit"
            type="submit"
            class="bg-primary text-primary-content hover:bg-primary/90 font-bold px-12 py-4 rounded-full cursor-pointer transition text-lg shadow-lg hover:shadow-xl hover:scale-105 transform duration-200"
        >
            Send Message
        </button>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");

    if (form) {
        const status = form.querySelector<HTMLDivElement>("#form-status");
        const submitButton =
            form.querySelector<HTMLButtonElement>("#contact-submit");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!status || !submitButton) return;

            status.hidden = false;
            status.className = "mt-4 text-sm";
            status.textContent = "Sending your message...";
            submitButton.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: {
                        Accept: "application/json",
                    },
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || "Unable to send your message."
                    );
                }

                status.className = "mt-4 text-sm text-green-700";
                status.textContent =
                    "Thank you! Your message has been sent successfully.";
                form.reset();
            } catch (error) {
                status.className = "mt-4 text-sm text-red-700";
                status.textContent =
                    error instanceof Error &&
                    error.message !== "Failed to fetch"
                        ? error.message
                        : "Sorry, your message could not be sent. Please try again.";
            } finally {
                submitButton.disabled = false;
            }
        });
    }
</script>

