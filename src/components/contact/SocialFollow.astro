---
const socialLinks = [
    {
        name: "Pinterest",
        href: "https://in.pinterest.com/findablehome/",
    },
    {
        name: "Tumblr",
        href: "https://www.tumblr.com/blog/findablehome",
    },
];
---

<div>
    <h3 class="font-bold text-lg mb-4">Follow Findable Home</h3>

    <div class="flex gap-4">
        {socialLinks.map((link) => (
            <a
                href={link.href}
                aria-label={link.name}
                title={link.name}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-circle btn-ghost hover:bg-primary/10 hover:text-primary transition-colors"
            >
                {link.name === "Pinterest" ? (
                    <svg
                        viewBox="0 0 24 24"
                        class="w-6 h-6"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M12 2a10 10 0 0 0-3.64 19.31c-.02-.78 0-1.72.19-2.57l1.34-5.67s-.33-.66-.33-1.63c0-1.53.89-2.67 2-2.67.94 0 1.4.7 1.4 1.55 0 .95-.61 2.38-.93 3.7-.26 1.11.56 2.02 1.65 2.02 1.98 0 3.32-2.54 3.32-5.55 0-2.29-1.54-4-4.35-4-3.17 0-5.15 2.36-5.15 4.99 0 .91.27 1.55.69 2.05.19.23.22.32.15.58l-.21.84c-.07.27-.28.37-.52.27-1.46-.6-2.14-2.21-2.14-4.02 0-2.99 2.52-6.57 7.52-6.57 4.02 0 6.66 2.91 6.66 6.03 0 4.13-2.3 7.21-5.69 7.21-1.14 0-2.21-.62-2.58-1.32l-.74 2.94c-.22.85-.66 1.7-1.06 2.36A10 10 0 1 0 12 2Z" />
                    </svg>
                ) : (
                    <img
    src="/images/branding/tumblr.svg"
    alt=""
    aria-hidden="true"
    class="w-5 h-5"
/>
                )}
            </a>
        ))}
    </div>
</div>
