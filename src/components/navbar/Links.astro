---
import { Icon } from "astro-icon/components";

const categories = [
    { name: "Home", href: "/" },
    { name: "Shop", href: "/shop/" },
    { name: "Blog", href: "/blog/" },
];
---

<div class="bg-primary text-primary-content shadow-sm relative z-40">
    <div
        class="max-w-7xl mx-auto flex justify-between items-center text-xs sm:text-sm font-medium h-10"
    >
        <!-- Mobile Navigation Bar -->
        <div class="flex sm:hidden w-full items-center h-full px-4">
            <button
                id="mobile-links-toggle"
                type="button"
                aria-label="Open navigation menu"
                aria-expanded="false"
                aria-controls="mobile-links-menu"
                class="flex items-center justify-center h-full w-12 hover:bg-white/10 transition-colors cursor-pointer"
            >
                <Icon name="lucide:menu" class="w-6 h-6" />
            </button>
        </div>

        <!-- Desktop: Main Navigation -->
        <div class="hidden sm:flex h-full items-center">
            {
                categories.map((cat) => (
                    <a
                        href={cat.href}
                        class="flex items-center h-full px-4 hover:bg-white/10 text-white/90 hover:text-white transition-all cursor-pointer"
                    >
                        {cat.name}
                    </a>
                ))
            }
        </div>

        <!-- Desktop: Secondary Navigation -->
        <div class="hidden sm:flex h-full items-center">
            <a
                href="/about/"
                class="flex items-center h-full px-3 hover:bg-white/10 text-white/90 hover:text-white transition-all cursor-pointer"
            >
                About
            </a>

            <a
                href="/contact/"
                class="flex items-center h-full px-3 hover:bg-white/10 text-white/90 hover:text-white transition-all cursor-pointer"
            >
                Contact
            </a>

            <a
                href="/privacy-policy/"
                class="flex items-center h-full px-3 hover:bg-white/10 text-white/90 hover:text-white transition-all cursor-pointer"
            >
                Privacy
            </a>

            <a
                href="/affiliate-disclosure/"
                class="flex items-center h-full px-3 hover:bg-white/10 text-white/90 hover:text-white transition-all cursor-pointer"
            >
                Affiliate Disclosure
            </a>
        </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
        id="mobile-links-menu"
        class="sm:hidden grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out bg-primary overflow-hidden brightness-95"
        aria-hidden="true"
    >
        <div class="min-h-0 flex flex-col border-t border-white/10">
            {
                categories.map((cat) => (
                    <a
                        href={cat.href}
                        class="py-3 px-6 hover:bg-white/10 border-b border-white/5 transition-colors"
                    >
                        {cat.name}
                    </a>
                ))
            }

            <div
                class="bg-primary/50 py-2 px-6 text-white/60 uppercase text-[10px] tracking-widest font-bold"
            >
                More Info
            </div>

            <a
                href="/about/"
                class="py-3 px-6 hover:bg-white/10 border-b border-white/5 transition-colors"
            >
                About Us
            </a>

            <a
                href="/contact/"
                class="py-3 px-6 hover:bg-white/10 border-b border-white/5 transition-colors"
            >
                Contact
            </a>

            <a
                href="/privacy-policy/"
                class="py-3 px-6 hover:bg-white/10 border-b border-white/5 transition-colors"
            >
                Privacy Policy
            </a>

            <a
                href="/affiliate-disclosure/"
                class="py-3 px-6 hover:bg-white/10 border-b border-white/5 transition-colors"
            >
                Affiliate Disclosure
            </a>
        </div>
    </div>
</div>

<script>
    function setupToggle() {
        const toggleBtn = document.getElementById("mobile-links-toggle");
        const menu = document.getElementById("mobile-links-menu");

        if (!toggleBtn || !menu) return;

        if (toggleBtn.dataset.listenerAttached === "true") return;

        toggleBtn.addEventListener("click", () => {
            const isOpen = menu.classList.contains("menu-open");

            menu.classList.toggle("menu-open", !isOpen);
            menu.setAttribute("aria-hidden", String(isOpen));

            toggleBtn.setAttribute("aria-expanded", String(!isOpen));
            toggleBtn.setAttribute(
                "aria-label",
                isOpen ? "Open navigation menu" : "Close navigation menu",
            );
        });

        toggleBtn.dataset.listenerAttached = "true";
    }

    setupToggle();
    document.addEventListener("astro:page-load", setupToggle);
</script>

<style>
    #mobile-links-menu.menu-open {
        grid-template-rows: 1fr;
    }
</style>
