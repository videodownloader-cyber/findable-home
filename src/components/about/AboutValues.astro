---
import AboutCard from "./AboutCard.astro";

const values = [
    {
        title: "Practical Solutions",
        description:
            "We focus on useful organization and storage ideas that solve everyday household problems without unnecessary complexity.",
        icon: "lucide:house",
    },
    {
        title: "Renter-Friendly Ideas",
        description:
            "We prioritize flexible storage and organization options that help renters make better use of their space without permanent changes.",
        icon: "lucide:package-check",
    },
    {
        title: "Thoughtful Choices",
        description:
            "We help readers understand practical options and choose products that fit their needs, space, and budget.",
        icon: "lucide:lightbulb",
    },
];
---

<section class="py-20 bg-slate-50 px-4">
    <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span
                class="text-primary font-bold uppercase tracking-widest text-sm mb-4 block"
                >Our Values</span
            >
            <h2
                class="text-3xl md:text-5xl font-black text-slate-900 uppercase"
            >
                What Drives Us Forward
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {values.map((value) => <AboutCard {...value} />)}
        </div>
    </div>
</section>
