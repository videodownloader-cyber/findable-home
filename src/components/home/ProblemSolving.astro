---
import { getLatestArticles } from "../../data/content";

const latestArticles = getLatestArticles(5);

/*
 * The editorial section requires five published articles
 * because the visual layout contains one large feature
 * and four supporting stories.
 *
 * If there are not enough articles, render nothing.
 */
const hasEnoughContent = latestArticles.length === 5;
---

{
    hasEnoughContent && (
        <section class="py-16 sm:py-20 lg:py-24 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Section Heading -->
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
                    <div class="max-w-2xl">
                        <p class="text-xs sm:text-sm font-medium uppercase tracking-[0.2em] text-slate-500 mb-3">
                            Latest ideas
                        </p>

                        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-slate-900">
                            Ideas for a home that works better
                        </h2>
                    </div>

                    <a
                        href="/blog"
                        class="shrink-0 text-sm font-medium text-slate-900 hover:underline"
                    >
                        Explore all guides →
                    </a>
                </div>

                <!-- Editorial Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                    <!-- Large Latest Article -->
                    <a
                        href={latestArticles[0].path}
                        class="group block"
                    >
                        <div class="overflow-hidden bg-slate-100 aspect-[4/5]">
                            <img
                                src={latestArticles[0].image}
                                alt={latestArticles[0].title}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                        </div>

                        <div class="pt-5 pr-4">
                            <p class="text-[10px] font-medium tracking-[0.18em] text-slate-500 mb-2">
                                {latestArticles[0].tags[0]}
                            </p>

                            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-medium tracking-tight leading-tight text-slate-900 group-hover:underline">
                                {latestArticles[0].title}
                            </h3>

                            <p class="mt-3 text-sm text-slate-500">
                                By {latestArticles[0].author}
                            </p>
                        </div>
                    </a>

                    <!-- Four Supporting Latest Articles -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-8">

                        {
                            latestArticles.slice(1).map((article) => (
                                <a
                                    href={article.path}
                                    class="group block"
                                >
                                    <div class="overflow-hidden bg-slate-100 aspect-[4/3]">
                                        <img
                                            src={article.image}
                                            alt={article.title}
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                        />
                                    </div>

                                    <div class="pt-4">
                                        <p class="text-[9px] font-medium tracking-[0.18em] text-slate-500 mb-2">
                                            {article.tags[0]}
                                        </p>

                                        <h3 class="text-lg sm:text-xl font-medium leading-snug tracking-tight text-slate-900 group-hover:underline">
                                            {article.title}
                                        </h3>

                                        <p class="mt-2 text-[10px] uppercase tracking-[0.12em] text-slate-500">
                                            Read more →
                                        </p>
                                    </div>
                                </a>
                            ))
                        }

                    </div>
                </div>

            </div>
        </section>
    )
}