---
import { Icon } from "astro-icon/components";
---

<section class="relative w-full overflow-hidden">
    <div class="swiper hero-swiper h-[350px] sm:h-[450px] md:h-[500px]">
        <div class="swiper-wrapper">

            <!-- Slide 1 -->
            <div class="swiper-slide relative">
                <img
                    src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=1920&auto=format&fit=crop"
                    alt="Bright organized home interior"
                    class="absolute inset-0 w-full h-full object-cover"
                />

                <div
                    class="absolute inset-0 bg-black/30 flex items-center justify-center text-center px-4"
                >
                    <div class="max-w-3xl animate-fade-in">
                        <p
                            class="text-sm md:text-base text-white mb-3 uppercase tracking-[0.2em] font-semibold"
                        >
                            Findable Home
                        </p>

                        <h2
                            class="text-4xl md:text-6xl font-bold text-white tracking-tight"
                        >
                            Make Your Home Work Better
                        </h2>

                        <a
                            href="/blog"
                            class="inline-flex mt-7 px-7 py-3 bg-white text-slate-900 font-medium rounded-full shadow-xl hover:scale-105 transition-transform"
                        >
                            Explore Guides
                        </a>
                    </div>
                </div>
            </div>


            <!-- Slide 2 -->
            <div class="swiper-slide relative">
                <img
                    src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?q=80&w=1920&auto=format&fit=crop"
                    alt="Comfortable and organized living room"
                    class="absolute inset-0 w-full h-full object-cover"
                />

                <div
                    class="absolute inset-0 bg-black/30 flex items-center justify-start px-8 md:px-24"
                >
                    <div class="max-w-2xl">
                        <p
                            class="text-sm md:text-base text-white mb-3 uppercase tracking-[0.2em] font-semibold"
                        >
                            Everyday Spaces
                        </p>

                        <h2
                            class="text-4xl md:text-6xl font-bold text-white tracking-tight"
                        >
                            Less Clutter.<br />More Room.
                        </h2>

                        <a
                            href="/category/small-space-living"
                            class="inline-flex mt-7 px-7 py-3 bg-white text-slate-900 font-medium rounded-full shadow-xl hover:scale-105 transition-transform"
                        >
                            Find Ideas
                        </a>
                    </div>
                </div>
            </div>


            <!-- Slide 3 -->
            <div class="swiper-slide relative">
                <img
                    src="https://images.unsplash.com/photo-1556911220-bff31c812dba?q=80&w=1920&auto=format&fit=crop"
                    alt="Functional home kitchen"
                    class="absolute inset-0 w-full h-full object-cover"
                />

                <div
                    class="absolute inset-0 bg-black/30 flex items-center justify-center text-center px-4"
                >
                    <div class="max-w-3xl">
                        <p
                            class="text-sm md:text-base text-white mb-3 uppercase tracking-[0.2em] font-semibold"
                        >
                            Practical Solutions
                        </p>

                        <h2
                            class="text-4xl md:text-6xl font-bold text-white tracking-tight"
                        >
                            Better Storage Starts Here
                        </h2>

                        <a
                            href="/shop"
                            class="inline-flex mt-7 px-7 py-3 bg-white text-slate-900 font-medium rounded-full shadow-xl hover:scale-105 transition-transform"
                        >
                            Browse Solutions
                        </a>
                    </div>
                </div>
            </div>


            <!-- Slide 4 -->
            <div class="swiper-slide relative">
                <img
                    src="https://images.unsplash.com/photo-1617104678098-de229db51175?q=80&w=1920&auto=format&fit=crop"
                    alt="Thoughtfully arranged home interior"
                    class="absolute inset-0 w-full h-full object-cover"
                />

                <div
                    class="absolute inset-0 bg-black/30 flex items-center justify-end px-8 md:px-24"
                >
                    <div class="max-w-2xl text-right">
                        <p
                            class="text-sm md:text-base text-white mb-3 uppercase tracking-[0.2em] font-semibold"
                        >
                            Start With The Problem
                        </p>

                        <h2
                            class="text-4xl md:text-6xl font-bold text-white tracking-tight"
                        >
                            Find A Simpler Way
                        </h2>

                        <a
                            href="/blog"
                            class="inline-flex mt-7 px-7 py-3 bg-white text-slate-900 font-medium rounded-full shadow-xl hover:scale-105 transition-transform"
                        >
                            Explore Findable Home
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Navigation -->
        <div
            class="hero-next text-white! w-10 h-10 hover:scale-110 transition-transform hidden sm:flex items-center justify-center bg-black/20 hover:bg-black/40 rounded-full cursor-pointer absolute right-4 top-1/2 -translate-y-1/2 z-50"
        >
            <Icon name="lucide:chevron-right" class="w-6 h-6" />
        </div>

        <div
            class="hero-prev text-white! w-10 h-10 hover:scale-110 transition-transform hidden sm:flex items-center justify-center bg-black/20 hover:bg-black/40 rounded-full cursor-pointer absolute left-4 top-1/2 -translate-y-1/2 z-50"
        >
            <Icon name="lucide:chevron-left" class="w-6 h-6" />
        </div>

        <!-- Pagination -->
        <div class="swiper-pagination bottom-8!"></div>
    </div>
</section>


<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<style>
    :root {
        --swiper-pagination-color: var(--color-primary);
        --swiper-pagination-bullet-inactive-color: #fff;
        --swiper-pagination-bullet-inactive-opacity: 0.5;
        --swiper-pagination-bullet-size: 10px;
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }

    .swiper-pagination-bullet-active {
        width: 24px;
        border-radius: 5px;
        transition: width 0.3s ease;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out forwards;
    }
</style>


<script>
    import Swiper from "swiper";
    import {
        Navigation,
        Pagination,
        Autoplay,
        EffectFade,
    } from "swiper/modules";

    const initHeroSwiper = () => {
        new Swiper(".hero-swiper", {
            modules: [Navigation, Pagination, Autoplay, EffectFade],
            loop: true,
            effect: "fade",

            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },

            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },

            navigation: {
                nextEl: ".hero-next",
                prevEl: ".hero-prev",
            },
        });
    };

    initHeroSwiper();

    document.addEventListener("astro:after-swap", initHeroSwiper);
</script>