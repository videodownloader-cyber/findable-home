---
import { getFeaturedContent } from "../../data/content";

const featuredContent = getFeaturedContent(3);
---

{
    featuredContent.length > 0 && (
        <section class="py-10 sm:py-12 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Section Heading -->
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl sm:text-3xl font-medium tracking-tight text-slate-900">
                        Featured Content
                    </h2>

                    <a
                        href="/blog"
                        class="text-sm font-medium text-slate-900 hover:underline"
                    >
                        View all
                    </a>
                </div>

                <!-- Content Strip -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {
                        featuredContent.map((item) => (
                            <a
                                href={item.path}
                                class="group flex items-center gap-4 border-t border-slate-200 pt-4"
                            >
                                <!-- Small Image -->
                                <div class="w-24 h-20 sm:w-28 sm:h-24 shrink-0 overflow-hidden bg-slate-100">
                                    <img
                                        src={item.image}
                                        alt={item.title}
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                                </div>

                                <!-- Title + Author -->
                                <div>
                                    <h3 class="text-base sm:text-lg font-medium leading-snug text-slate-900 group-hover:underline">
                                        {item.title}
                                    </h3>

                                    <p class="mt-2 text-xs sm:text-sm text-slate-500">
                                        By {item.author}
                                    </p>
                                </div>
                            </a>
                        ))
                    }
                </div>

            </div>
        </section>
    )
}