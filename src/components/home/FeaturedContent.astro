---
import { blogPosts } from "../../data/blogData";

const featuredContent = [...blogPosts]
    .filter((post) => post.featured === true)
    .sort(
        (a, b) =>
            new Date(b.datePublished).getTime() -
            new Date(a.datePublished).getTime()
    )
    .slice(0, 3);
---

{
    featuredContent.length > 0 && (
        <section class="py-10 sm:py-12 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <div class="flex items-center justify-between mb-6">
                    <p class="text-xs sm:text-sm font-medium uppercase tracking-[0.18em] text-slate-700">
                        Featured
                    </p>

                    <a
                        href="/blog"
                        class="text-sm font-medium text-slate-900 hover:underline"
                    >
                        View all
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                    {
                        featuredContent.map((item) => (
                            <a
                                href={`/blog/${item.slug}/`}
                                class="group block"
                            >
                                <div class="overflow-hidden bg-slate-100 aspect-[4/3]">
                                    <img
                                        src={item.image}
                                        alt={item.imageAlt || item.title}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    />
                                </div>

                                <div class="pt-4">
                                    <p class="text-[10px] sm:text-xs font-medium uppercase tracking-[0.16em] text-slate-500 mb-2">
                                        {item.category}
                                    </p>

                                    <h3 class="text-lg sm:text-xl font-medium leading-snug tracking-tight text-slate-900 group-hover:underline">
                                        {item.title}
                                    </h3>

                                    <p class="mt-2 text-xs sm:text-sm text-slate-500">
                                        By {item.author}
                                    </p>
                                </div>
                            </a>
                        ))
                    }
                </div>

            </div>
        </section>
    )
}
