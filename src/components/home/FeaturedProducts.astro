
---
import { Icon } from "astro-icon/components";
import { getFeaturedProducts } from "../../data/featuredProducts";

const products = getFeaturedProducts(4);
---

{products.length > 0 && (
    <section class="pb-16 sm:pb-20 lg:pb-24 bg-white" id="featured-products-section">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-8 sm:mb-10">
                <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter">
                    Featured Products
                </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                {products.map((product) => (
                    <article
                        class="product-card group relative rounded-xl overflow-hidden border border-slate-200 bg-white shadow-sm hover:shadow-xl transition-shadow duration-300"
                        data-product-id={product.id}
                        data-product-category={product.category}
                    >
                        <div class="relative w-full aspect-[4/5] bg-slate-100 overflow-hidden">
                            {product.image ? (
                                <img
                                    src={product.image}
                                    alt={product.title}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full flex flex-col items-center justify-center px-6 text-center text-slate-400">
                                    <Icon name="lucide:image" class="w-10 h-10 mb-3" />
                                    <span class="text-xs uppercase tracking-[0.16em]">
                                        Product image pending
                                    </span>
                                </div>
                            )}

                            <div class="absolute inset-x-0 bottom-0 p-3 flex justify-end translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                                <a
                                    href={product.benableUrl}
                                    target="_blank"
                                    rel="nofollow sponsored noopener noreferrer"
                                    data-product-click
                                    data-destination-type="benable"
                                    aria-label={`View ${product.title}`}
                                    class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold text-slate-900 shadow-md hover:bg-slate-900 hover:text-white transition-colors"
                                >
                                    View Product
                                    <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" />
                                </a>
                            </div>
                        </div>

                        <div class="p-4">
                            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500 mb-2">
                                {product.category.replaceAll("-", " ")}
                            </p>

                            <h3
                                class="font-bold text-base sm:text-lg leading-snug text-slate-900 line-clamp-3"
                                title={product.title}
                            >
                                {product.title}
                            </h3>

                            <a
                                href={product.benableUrl}
                                target="_blank"
                                rel="nofollow sponsored noopener noreferrer"
                                data-product-click
                                data-destination-type="benable"
                                class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:underline"
                            >
                                Check product
                                <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
)}

<script>
    function trackProductClick(
        link: HTMLAnchorElement,
        card: HTMLElement
    ) {
        const productId = card.dataset.productId;
        const productCategory = card.dataset.productCategory;
        const destinationType = link.dataset.destinationType;

        if (!productId) return;

        const dataLayer = (window as Window & {
            dataLayer?: Record<string, unknown>[];
        }).dataLayer;

        if (!dataLayer) {
            console.warn("GTM dataLayer is unavailable.");
            return;
        }

        dataLayer.push({
            event: "affiliate_click",
            item_id: productId,
            item_name: card.querySelector("h3")?.textContent?.trim() ?? "",
            item_category: productCategory ?? "",
            placement: "homepage_featured",
            destination_type: destinationType ?? "unknown",
            link_url: link.href,
        });
    }

    function initProductTracking() {
        document.querySelectorAll<HTMLAnchorElement>(
            "#featured-products-section a[data-product-click]"
        ).forEach((link) => {
            if (link.dataset.trackingInitialized === "true") return;

            link.dataset.trackingInitialized = "true";

            link.addEventListener("click", () => {
                const card = link.closest<HTMLElement>("[data-product-id]");

                if (card) {
                    trackProductClick(link, card);
                }
            });
        });
    }

    initProductTracking();
    document.addEventListener("astro:page-load", initProductTracking);
</script>
