---
import Layout from "../layouts/Layout.astro";
import FormContact from "../components/contact/FormContact.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import SocialFollow from "../components/contact/SocialFollow.astro";
---

<Layout
    title="Contact Findable Home | Get in Touch"
    description="Contact Findable Home with questions, feedback, or suggestions about practical home organization, storage ideas, and renter-friendly solutions."
>
    <section class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
        <h1
            class="text-3xl md:text-5xl font-black text-center uppercase tracking-tighter mb-12"
        >
            Get in <span class="text-primary">Touch</span>
        </h1>

        <div class="flex flex-col lg:flex-row items-start gap-12 lg:gap-20">
            <div class="w-full lg:w-4/12 flex flex-col justify-center">
                <div class="mb-8">
                    <p
                        class="text-xl md:text-2xl font-medium text-base-content leading-relaxed"
                    >
                        Questions or feedback? Get in touch.
                    </p>
                </div>

                <ContactInfo />
                <SocialFollow />
            </div>

            <div class="w-full lg:w-8/12">
                <FormContact />
            </div>
        </div>
    </section>
</Layout>
