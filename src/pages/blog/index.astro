
---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blogData";
import BlogCard from "../../components/blog/BlogCard.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Pagination from "../../components/ui/Pagination.astro";

const url = new URL(Astro.request.url);
const currentPage = Math.max(
    1,
    parseInt(url.searchParams.get("page") || "1", 10) || 1,
);

const postsPerPage = 6;
const totalPages = Math.ceil(blogPosts.length / postsPerPage);
const start = (currentPage - 1) * postsPerPage;
const currentPosts = blogPosts.slice(start, start + postsPerPage);
---

<Layout
    title="Home Organization Tips & Storage Ideas | Findable Home"
    description="Explore practical home organization tips, small-space storage ideas, and renter-friendly solutions for kitchens, bathrooms, closets, and everyday spaces."
>
    <section class="max-w-7xl mx-auto px-4 py-10 lg:py-16">
        <div class="mb-8">
            <Breadcrumbs
                items={[
                    { label: "Home", href: "/" },
                    { label: "Blog", href: "/blog" },
                ]}
            />
        </div>

        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-base-content">
                Home Organization <span class="text-primary">Ideas</span>
            </h1>

            <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
                Practical storage ideas, renter-friendly solutions, and simple
                ways to make the most of your space.
            </p>
        </div>

        {currentPosts.length > 0 ? (
            <>
                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {currentPosts.map((post) => <BlogCard post={post} />)}
                </div>

                {totalPages > 1 && (
                    <div class="flex justify-center mt-12">
                        <Pagination
                            currentPage={currentPage}
                            totalPages={totalPages}
                            baseUrl="/blog"
                        />
                    </div>
                )}
            </>
        ) : (
            <div class="max-w-2xl mx-auto text-center py-12 px-6 rounded-2xl bg-base-200">
                <h2 class="text-2xl font-bold text-base-content mb-3">
                    Helpful ideas are on the way
                </h2>
                <p class="text-base-content/70 leading-relaxed mb-6">
                    We're preparing practical guides to help you organize
                    everyday spaces, solve storage problems, and find
                    renter-friendly solutions. Check back soon for new articles.
                </p>
                <a href="/shop/" class="btn btn-primary">
                    Explore Storage Solutions
                </a>
            </div>
        )}
    </section>
</Layout>

