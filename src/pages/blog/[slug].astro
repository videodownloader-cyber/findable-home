---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blogData";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const siteUrl = "https://findablehome.me";
const articleUrl = new URL(`/blog/${post.slug}`, siteUrl).href;
const articleImage = new URL(post.image, siteUrl).href;
const authorImage = new URL(post.authorImage ?? "/images/authors/carolina-wilson.webp", siteUrl).href;

const toSchemaDate = (value) => {
  if (!value) return undefined;
  const dateValue = new Date(value);
  return Number.isNaN(dateValue.getTime()) ? undefined : dateValue.toISOString();
};

const datePublished = toSchemaDate(post.datePublished ?? post.date);
const dateModified = toSchemaDate(post.dateModified ?? post.datePublished ?? post.date);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "headline": post.title,
  "description": post.metaDescription ?? post.description,
  "image": [articleImage],
  "author": {
    "@type": "Person",
    "name": post.author,
    "url": new URL("/about/", siteUrl).href,
    "image": authorImage
  },
  "publisher": {
    "@type": "Organization",
    "name": "Findable Home",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/images/branding/findable-home-logo.webp", siteUrl).href
    }
  },
  ...(datePublished ? { "datePublished": datePublished } : {}),
  ...(dateModified ? { "dateModified": dateModified } : {})
};

// Filter related articles
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleSchema)} /></Fragment>

<Layout
  title={post.seoTitle ?? post.title}
  description={post.metaDescription ?? post.description}
  canonical={`/blog/${post.slug}`}
  ogType="article"
  image={post.image}
>
  <article class="w-full max-w-5xl mx-auto px-4 py-10 lg:py-16 lg:translate-x-[-3rem]">
    <div class="mb-8">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/blog" },
          {
            label: post.title.substring(0, 20) + "...",
            href: Astro.url.pathname,
          }, // Truncate for cleaner UI
        ]}
      />
    </div>

    <div class="mb-8 text-left">
      <h1 class="text-3xl md:text-5xl font-extrabold text-base-content mb-5 leading-tight">
        {post.title}
      </h1>

      <div class="flex items-center gap-3 mb-6">
        <img
          src={post.authorImage ?? "/images/authors/carolina-wilson.webp"}
          alt={post.author}
          width="56"
          height="56"
          class="w-14 h-14 object-cover shrink-0 rounded-full"
          loading="eager"
        />
        <div class="text-sm">
          <p class="font-semibold text-base-content">{post.author}</p>
          <p class="text-base-content/60">Updated {post.date}</p>
        </div>
      </div>

      {post.content.match(/<p class="affiliate-disclosure">.*?<\/p>/s) && (
        <div class="affiliate-disclosure mb-6 text-sm leading-relaxed">
          <Fragment set:html={post.content.match(/<p class="affiliate-disclosure">.*?<\/p>/s)[0]} />
        </div>
      )}
    </div>

    <img
      src={post.image}
      alt={post.imageAlt ?? post.title}
      width="1600"
      height="900"
      fetchpriority="high"
      class="w-full h-auto max-h-[36rem] object-cover object-center mb-8 md:mb-10"
    />

    <div
      class={`article-content max-w-none lg:max-w-[800px] ${post.slug === "small-pantry-door-ideas" ? "small-pantry-door-ideas" : ""}`}
      set:html={post.content.replace(/<p class="affiliate-disclosure">.*?<\/p>\s*/s, "")}
    />

    <div class="mt-12 pt-8 border-t border-base-200">
      <a href="/blog" class="btn btn-outline btn-primary rounded-full gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Blog
      </a>
    </div>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="mt-20">
          <h2 class="text-3xl font-bold text-base-content mb-8 border-l-4 border-primary pl-4">
            Related Articles
          </h2>

          <div class="grid gap-8 md:grid-cols-2">
            {relatedPosts.map((p) => (
              <a
                href={`/blog/${p.slug}`}
                class="card bg-base-100 shadow-lg hover:shadow-2xl transition-all duration-300 group overflow-hidden border border-base-200"
              >
                <figure class="h-48 overflow-hidden">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </figure>
                <div class="card-body">
                  <h3 class="card-title text-lg group-hover:text-primary transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-base-content/70 text-sm line-clamp-2">
                    {p.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>

<style>
  .affiliate-disclosure :global(p) {
    font-style: italic;
  }

  .affiliate-disclosure :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content {
    color: var(--color-base-content);
    font-size: 1.0625rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .article-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .article-content :global(h2) {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    line-height: 1.25;
    font-weight: 800;
    margin: 2.5rem 0 1rem;
  }

  .article-content :global(h3) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.35;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.75rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li) {
    margin: 0.15rem 0;
    padding-left: 0.15rem;
  }

  .article-content :global(li p) {
    margin: 0.2rem 0;
  }

  .article-content :global(ul ul),
  .article-content :global(ol ol),
  .article-content :global(ul ol),
  .article-content :global(ol ul) {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .article-content :global(strong) {
    font-weight: 700;
  }

  .article-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-content :global(table) {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin: 1.5rem 0 2rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.8rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-base-300);
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .article-content :global(th) {
    font-weight: 700;
    color: var(--color-base-content);
    background: transparent;
  }

  .article-content :global(td) {
    color: var(--color-base-content);
  }

  .article-content.small-pantry-door-ideas :global(p.article-image) {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 1.5rem auto;
  }

  .article-content.small-pantry-door-ideas :global(p.article-image a) {
    display: block;
    width: min(100%, 250px);
    margin: 0 auto;
  }

  .article-content.small-pantry-door-ideas :global(p.article-image img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    object-fit: contain;
  }

  .article-content :global(figure) {
    width: 100%;
    margin: 2rem auto;
  }

  .article-content :global(figure img) {
    display: block;
    width: 100%;
    max-height: 28rem;
    object-fit: contain;
    border-radius: 0;
  }


  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 0;
  }

  .article-content :global(p > img) {
    width: 100%;
    max-height: 28rem;
    object-fit: contain;
    margin: 2rem auto;
  }
\n  .article-content :global(figcaption) {
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
    margin-top: 0.6rem;
    color: #78716c;
  }

  @media (max-width: 640px) {
    .article-content {
      font-size: 1rem;
    }

    .article-content :global(table) {
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.45rem 0.35rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.6rem;
    }
  }
</style>

</Layout>
