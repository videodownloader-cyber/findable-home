---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blogData";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Filter related articles
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Layout
  title={post.seoTitle ?? post.title}
  description={post.metaDescription ?? post.description}
  canonical={`/blog/${post.slug}`}
  ogType="article"
  image={post.image}
>
  <article class="max-w-5xl mx-auto px-4 py-10 lg:py-16">
    <div class="mb-8">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/blog" },
          {
            label: post.title.substring(0, 20) + "...",
            href: Astro.url.pathname,
          }, // Truncate for cleaner UI
        ]}
      />
    </div>

    <img
      src={post.image}
      alt={post.imageAlt ?? post.title}
      class="w-full h-56 sm:h-72 md:h-[32rem] lg:h-[36rem] object-cover object-center rounded-3xl shadow-xl mb-8 md:mb-10"
    />

    <div class="mb-8 text-center md:text-left">
      <h1
        class="text-3xl md:text-5xl font-extrabold text-base-content mb-4 leading-tight"
      >
        {post.title}
      </h1>

      <p
        class="text-base-content/60 text-sm font-medium flex items-center justify-center md:justify-start gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        {post.date}
        <span class="mx-1">•</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
        {post.author}
      </p>
    </div>

    <div
      class="article-content max-w-none"
      set:html={post.content}
    />

    <div class="mt-12 pt-8 border-t border-base-200">
      <a href="/blog" class="btn btn-outline btn-primary rounded-full gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Blog
      </a>
    </div>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="mt-20">
          <h2 class="text-3xl font-bold text-base-content mb-8 border-l-4 border-primary pl-4">
            Related Articles
          </h2>

          <div class="grid gap-8 md:grid-cols-2">
            {relatedPosts.map((p) => (
              <a
                href={`/blog/${p.slug}`}
                class="card bg-base-100 shadow-lg hover:shadow-2xl transition-all duration-300 group overflow-hidden border border-base-200"
              >
                <figure class="h-48 overflow-hidden">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </figure>
                <div class="card-body">
                  <h3 class="card-title text-lg group-hover:text-primary transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-base-content/70 text-sm line-clamp-2">
                    {p.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>

<style>
  .article-content {
    color: var(--color-base-content);
    font-size: 1.0625rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .article-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .article-content :global(h2) {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    line-height: 1.25;
    font-weight: 800;
    margin: 2.5rem 0 1rem;
  }

  .article-content :global(h3) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.35;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.75rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li) {
    margin: 0.15rem 0;
    padding-left: 0.15rem;
  }

  .article-content :global(li p) {
    margin: 0.2rem 0;
  }

  .article-content :global(ul ul),
  .article-content :global(ol ol),
  .article-content :global(ul ol),
  .article-content :global(ol ul) {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .article-content :global(strong) {
    font-weight: 700;
  }

  .article-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-content :global(table) {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin: 1.5rem 0 2rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.8rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-base-300);
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .article-content :global(th) {
    font-weight: 700;
    color: var(--color-base-content);
    background: transparent;
  }

  .article-content :global(td) {
    color: var(--color-base-content);
  }

  .article-content :global(figure) {
    width: 100%;
    margin: 2rem auto;
  }

  .article-content :global(figure img) {
    display: block;
    width: 100%;
    max-height: 28rem;
    object-fit: contain;
    border-radius: 0.75rem;
  }

  .article-content :global(figcaption) {
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
    margin-top: 0.6rem;
    color: #78716c;
  }

  @media (max-width: 640px) {
    .article-content {
      font-size: 1rem;
    }

    .article-content :global(table) {
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.45rem 0.35rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.6rem;
    }
  }
</style>

</Layout>
