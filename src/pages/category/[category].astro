
---
import Layout from "../../layouts/Layout.astro";
import CategoriesHeader from "../../components/categories/CategoriesHeader.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import CardProduct from "../../components/products/CardProduct.astro";
import ShopProductCard from "../../components/products/ShopProductCard.astro";
import { products } from "../../data/products";
import { categories } from "../../data/home";
import { featuredProducts } from "../../data/featuredProducts";

export async function getStaticPaths() {
    const householdSlugs = [
        "kitchen",
        "pantry",
        "closet",
        "bathroom",
        "laundry",
        "entryway",
        "office",
        "under-the-sink",
    ];

    // Preserve the original store category routes.
    const storeCategories = [
        ...new Set(products.map((product) => product.category)),
    ];

    const storePaths = storeCategories.map((category) => ({
        params: {
            category: category.toLowerCase().trim().replace(/\s+/g, "-"),
        },
        props: {
            categoryName: category,
            categoryType: "store",
            categoryProducts: products.filter(
                (product) => product.category === category,
            ),
            householdCategoryProducts: [],
            image: undefined,
        },
    }));

    // Generate Findable Home's household-space routes.
    const householdPaths = householdSlugs.map((slug) => {
        const categoryData = categories.find(
            (category) =>
                category.name.toLowerCase().trim().replace(/\s+/g, "-") ===
                slug,
        );

        return {
            params: { category: slug },
            props: {
                categoryName: categoryData?.name ?? slug,
                categoryType: "household",
                categoryProducts: [],
                householdCategoryProducts: featuredProducts.filter(
                    (product) => product.category === slug,
                ),
                image: categoryData?.image,
            },
        };
    });

    return [...storePaths, ...householdPaths];
}

const {
    categoryName,
    categoryType,
    categoryProducts,
    householdCategoryProducts,
    image,
} = Astro.props;

const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: categoryName },
];
---

<Layout title={`${categoryName} | Findable Home`}>
    <CategoriesHeader title={categoryName} image={image} />

    <div class="min-h-screen bg-white pb-20 pt-10">
        <div class="mx-auto max-w-7xl px-6">
            <div id="breadcrumbs-container">
                <Breadcrumbs items={breadcrumbItems} />
            </div>

            <main class="py-12">
                {
                    categoryType === "household" ? (
                        <>
                            <div class="mb-8">
                                <h1 class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
                                    {categoryName} organization finds
                                </h1>

                                <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">
                                    Explore selected products and practical ideas
                                    for organizing this space in your home.
                                </p>
                            </div>

                            {householdCategoryProducts.length > 0 ? (
                                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                                    {householdCategoryProducts.map((product) => (
                                        <ShopProductCard
                                            id={product.id}
                                            title={product.title}
                                            category={product.category}
                                            image={product.image}
                                            benableUrl={product.benableUrl}
                                        />
                                    ))}
                                </div>
                            ) : (
                                <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
                                    <h2 class="text-xl font-bold text-slate-900">
                                        More {categoryName.toLowerCase()} solutions are coming
                                    </h2>

                                    <p class="mx-auto mt-3 max-w-xl leading-relaxed text-slate-600">
                                        We're building this collection of practical
                                        household solutions. In the meantime, explore
                                        the Shop for our currently selected finds.
                                    </p>

                                    <a
                                        href="/shop/"
                                        class="mt-6 inline-flex rounded-xl bg-primary px-6 py-3 font-bold text-primary-content transition-opacity hover:opacity-85"
                                    >
                                        Explore the Shop
                                    </a>
                                </div>
                            )}
                        </>
                    ) : (
                        <>
                            <div
                                id="products-grid"
                                class="grid grid-cols-1 gap-8 animate-fade-in sm:grid-cols-2 lg:grid-cols-4"
                            >
                                {categoryProducts.map((product) => (
                                    <div
                                        class="product-item transition-all duration-300"
                                        data-subcategory={
                                            product.subcategory?.toLowerCase() || ""
                                        }
                                    >
                                        <CardProduct
                                            title={product.title}
                                            price={product.price}
                                            images={product.images}
                                            stock={product.stock}
                                            slug={product.slug}
                                        />
                                    </div>
                                ))}
                            </div>

                            <div
                                id="no-products-msg"
                                class="hidden rounded-3xl border-2 border-dashed border-slate-200 bg-slate-50 py-24 text-center"
                            >
                                <p class="font-bold uppercase tracking-widest text-slate-400">
                                    No products found in this category
                                </p>
                            </div>
                        </>
                    )
                }
            </main>
        </div>
    </div>
</Layout>

<script>
    function filterProducts() {
        const grid = document.getElementById("products-grid");
        if (!grid) return;

        const urlParams = new URLSearchParams(window.location.search);
        const subCategory = urlParams.get("sub")?.toLowerCase();

        const productItems = document.querySelectorAll<HTMLElement>(
            "#products-grid .product-item",
        );

        const noProductsMsg = document.getElementById("no-products-msg");
        let visibleCount = 0;

        productItems.forEach((item) => {
            const matches =
                !subCategory || item.dataset.subcategory === subCategory;

            item.classList.toggle("hidden", !matches);

            if (matches) visibleCount++;
        });

        if (subCategory) {
            const breadcrumbNav = document.querySelector(
                'nav[aria-label="Breadcrumb"] ol',
            );

            if (
                breadcrumbNav &&
                !document.getElementById("breadcrumb-sub")
            ) {
                const li = document.createElement("li");
                li.id = "breadcrumb-sub";
                li.className = "flex items-center";

                const separator = document.createElement("span");
                separator.className = "mx-2 text-gray-400";
                separator.textContent = "/";
                separator.setAttribute("aria-hidden", "true");

                const label = document.createElement("span");
                label.className =
                    "text-sm font-medium capitalize text-gray-500";
                label.textContent = subCategory;

                li.append(separator, label);
                breadcrumbNav.appendChild(li);
            }
        }

        noProductsMsg?.classList.toggle("hidden", visibleCount > 0);
    }

    filterProducts();
    document.addEventListener("astro:page-load", filterProducts);
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 0.6s ease-out forwards;
    }
</style>
